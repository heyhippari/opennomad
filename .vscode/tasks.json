{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset", "linux-debug"
            ],
            "osx": {
                "args": [
                    "--preset", "macos-debug"
                ]
            },
            "windows": {
                "args": [
                    "--preset", "windows-debug"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Configure the Debug preset for the current platform."
        },
        {
            "label": "CMake: Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "--preset", "linux-debug"
            ],
            "osx": {
                "args": [
                    "--build", "--preset", "macos-debug"
                ]
            },
            "windows": {
                "args": [
                    "--build", "--preset", "windows-debug"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: Configure Debug"
            ],
            "detail": "Build the Debug preset for the current platform."
        },
        {
            "label": "CMake: Configure Linux Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset", "linux-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VCPKG_ROOT": "${env:VCPKG_ROOT}"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "detail": "Configure the Linux Debug preset."
        },
        {
            "label": "CMake: Configure Linux Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset", "linux-release"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VCPKG_ROOT": "${env:VCPKG_ROOT}"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "detail": "Configure the Linux Release preset."
        },
        {
            "label": "CMake: Build Linux Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "--preset", "linux-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "dependsOn": [
                "CMake: Configure Linux Debug"
            ],
            "detail": "Build the Linux Debug preset."
        },
        {
            "label": "CMake: Build Linux Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "--preset", "linux-release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "dependsOn": [
                "CMake: Configure Linux Release"
            ],
            "detail": "Build the Linux Release preset."
        },
        {
            "label": "CMake: Test Linux Debug",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--preset", "linux-debug", "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test",
            "dependsOn": [
                "CMake: Build Linux Debug"
            ],
            "detail": "Test the Linux Debug preset."
        },
        {
            "label": "CMake: Test Linux Release",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--preset", "linux-release", "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test",
            "dependsOn": [
                "CMake: Build Linux Release"
            ],
            "detail": "Test the Linux Release preset."
        },
        {
            "label": "CMake: Clean Linux Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "--preset", "linux-debug",
                "--target", "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Clean the Linux Debug preset."
        },
        {
            "label": "CMake: Clean Linux Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "--preset", "linux-release",
                "--target", "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Clean the Linux Release preset."
        },
        {
            "label": "CMake: Workflow macOS Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--workflow", "--preset", "macos-debug"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": "build",
            "detail": "Configure, build, and test the macOS Debug preset."
        },
        {
            "label": "CMake: Workflow macOS Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--workflow", "--preset", "macos-release"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": "build",
            "detail": "Configure, build, and test the macOS Release preset."
        },
        {
            "label": "CMake: Workflow Windows Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--workflow", "--preset", "windows-debug"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": "build",
            "detail": "Configure, build, and test the Windows Debug preset."
        },
        {
            "label": "CMake: Workflow Windows Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--workflow", "--preset", "windows-release"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": "build",
            "detail": "Configure, build, and test the Windows Release preset."
        },
        {
            "label": "CMake: Configure Quality",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset", "quality"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": "build",
            "detail": "Configure the canonical clang-format and clang-tidy quality preset."
        },
        {
            "label": "CMake: Check Format",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "--preset", "quality", "--target", "check-format"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": "test",
            "dependsOn": [
                "CMake: Configure Quality"
            ],
            "detail": "Run the canonical clang-format check."
        },
        {
            "label": "CMake: Run clang-tidy",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "--preset", "quality", "--target", "tidy"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": "test",
            "dependsOn": [
                "CMake: Configure Quality"
            ],
            "detail": "Run the canonical clang-tidy checks."
        },
        {
            "label": "CPack: Package Release",
            "type": "shell",
            "command": "cpack",
            "args": [
                "--config", "build/linux-release/CPackConfig.cmake"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build",
            "dependsOn": [
                "CMake: Build Linux Release"
            ],
            "detail": "Create a distribution package from the Linux Release preset."
        }
    ]
}